st.write(
    "Visualiza cómo varía el costo total al modificar el tamaño del lote $Q$:"
)

# Generar puntos para la curva de costos
q_vals = np.linspace(max(100, r["Q"] * 0.2), r["Q"] * 2.5, 100)
if modelo == "Compra sin déficit":
  costos_totales = (C1 * D) + (C2 * (D / q_vals)) + (C3 * q_vals / 2)
elif modelo == "Compra con déficit":
  # Aproximación visual del costo con déficit
  costos_totales = (
      (C1 * D)
      + (C2 * (D / q_vals))
      + (C3 * ((q_vals - (C3 * q_vals / (C3 + C4))) ** 2) / (2 * q_vals))
      + (C4 * ((C3 * q_vals / (C3 + C4)) ** 2) / (2 * q_vals))
  )
else:
  # Curva generalizada para manufactura
  k_factor = (
      r["k"] if "k" in r else 1.0
  )  # Simplified visual curve representation
  costos_totales = (C1 * D) + (C2 * (D / q_vals)) + (C3 * q_vals * k_factor / 2)

df_chart = pd.DataFrame(
    {"Tamaño de Lote (Q)": q_vals, "Costo Total ($)": costos_totales}
).set_index("Tamaño de Lote (Q)")

st.line_chart(df_chart)
